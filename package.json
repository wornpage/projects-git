{
  "name": "projects-agent-git",
  "version": "0.1.0",
  "private": true,
  "description": "Concurrent Git work with independent evidence and human acceptance",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "setup:check": "node scripts/setup-check.mjs",
    "dev": "node src/local/server.mjs",
    "dev:demo": "wrangler dev --local --config wrangler.demo.jsonc --ip 127.0.0.1 --port 8894 --inspector-port 9294",
    "dev:entrance": "wrangler dev --local --config wrangler.entrance-preview.jsonc --ip 127.0.0.1 --port 8908 --inspector-port 9308",
    "dev:model": "node --env-file=.env src/local/server.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "types": "wrangler types src/cloudflare/worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.cloudflare.json --noEmit",
    "verifier:stamp": "node scripts/verifier-fingerprint.mjs --write",
    "build": "node scripts/verifier-fingerprint.mjs && node scripts/syntax-bundle.mjs && wrangler deploy --dry-run --outdir dist && npm run build:demo && npm run build:subscriptions && npm run build:entrance",
    "build:entrance": "node scripts/entrance-assets.mjs && wrangler deploy --config wrangler.entrance-preview.jsonc --dry-run --outdir dist/entrance",
    "build:demo": "wrangler deploy --config wrangler.demo.jsonc --dry-run --outdir dist/demo",
    "build:subscriptions": "wrangler deploy --config wrangler.subscriptions.jsonc --dry-run --outdir dist/subscriptions",
    "check": "npm run test && npm run typecheck && npm run build",
    "dev:cloudflare": "wrangler dev --local"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.4",
    "esbuild": "0.28.1",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261001.0-alpha",
    "prismjs": "1.30.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "isomorphic-git": "1.43.0",
    "jose": "6.2.12",
    "memfs": "4.80.0"
  },
  "overrides": {
    "miniflare@5.20261001.0-alpha": {
      "sharp": "0.35.5"
    }
  }
}
